# ==============================================
# Video Merger API — متغيرات البيئة
# انسخ هذا الملف إلى .env محليًا واملأ القيم
# (على Vercel: Settings → Environment Variables)
# ==============================================

# إلزاميان — قاعدة Turso (أنشئها بـ: turso db create <name>)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# اختياري — يُفرض رابط النتائج العام بدل استنتاجه من الترويسات (مفيد خلف وكيل)
# MERGER_PUBLIC_BASE=https://your-project.vercel.app

# اختياري — كل الحدود التالية لها افتراضيات مطابقة للمواصفة
# MAX_SOURCES=10
# SOURCE_MAX_MB=200
# OUTPUT_MAX_MB=150
# MAX_TOTAL_DURATION_SEC=600
# UPLOAD_CHUNK_BYTES=4194304
# BLOB_CHUNK_BYTES=2097152
# READ_PAGE_ROWS=8
# RETENTION_HOURS=24
# FFMPEG_PRESET=medium
