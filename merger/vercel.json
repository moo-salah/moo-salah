{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/**/*.js": {
      "maxDuration": 300,
      "includeFiles": [
        "node_modules/ffmpeg-static/**",
        "node_modules/ffprobe-static/**"
      ]
    }
  },
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "0 3 * * *"
    }
  ]
}
