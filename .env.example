# ==============================================
# MCP Media Generator — متغيرات البيئة
# انسخ هذا الملف إلى .env.local محليًا واملأ القيم
# (على Vercel: Settings → Environment Variables)
# ==============================================

# إلزاميان — قاعدة Turso
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# إلزامي — عنوان خدمة دمج الفيديو المنشورة (مشروع Vercel منفصل من مجلد merger/)
# مثال: https://moo-salah-merger.vercel.app
MERGER_API_BASE=

# اختياري — إن ضُبط يُطلب Authorization: Bearer <token> على /mcp
MCP_ACCESS_TOKEN=

# اختياري — تجاوز أسماء الموديلات لدى المزودين إن تغيّرت
# KIE_IMAGE_MODEL=gpt-image-2-6/flare-text-to-image
# KIE_VIDEO_MODEL=grok-imagine-video-1-5-preview
# COMETAPI_IMAGE_MODEL=gpt-image-2.6-flare-text-to-image
# COMETAPI_VIDEO_MODEL=grok-imagine-video-1-5-preview
